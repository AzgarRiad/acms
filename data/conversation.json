[
  {
    "role": "user",
    "parts": [
      {
        "text": "What is the price of iphone 16?"
      }
    ]
  },
  {
    "role": "model",
    "parts": [
      {
        "function_call": {
          "name": "get_product_info",
          "args": {
            "product_name": "iphone 16"
          }
        }
      }
    ]
  },
  {
    "role": "user",
    "parts": [
      {
        "function_response": {
          "name": "get_product_info",
          "response": {
            "result": "[{\"Product_Name\": \"iPhone 16\", \"Price\": 99999.0}]"
          }
        }
      }
    ]
  },
  {
    "role": "model",
    "parts": [
      {
        "text": "The price of the iPhone 16 is 99,999 BDT. Would you like to place an order for it?"
      }
    ]
  },
  {
    "role": "user",
    "parts": [
      {
        "text": "yes"
      }
    ]
  },
  {
    "role": "model",
    "parts": [
      {
        "text": "Great! To place your order, could you please provide your name and the quantity you would like to order?"
      }
    ]
  },
  {
    "role": "user",
    "parts": [
      {
        "text": "I want 2, and my name is riad"
      }
    ]
  },
  {
    "role": "model",
    "parts": [
      {
        "function_call": {
          "name": "add_order",
          "args": {
            "quantity": 2,
            "product_name": "iPhone 16",
            "customer_name": "riad"
          }
        }
      }
    ]
  },
  {
    "role": "user",
    "parts": [
      {
        "function_response": {
          "name": "add_order",
          "response": {
            "result": {
              "status": "success",
              "order_id": 16,
              "customer_name": "riad",
              "product_name": "iPhone 16",
              "quantity": 2
            }
          }
        }
      }
    ]
  },
  {
    "role": "model",
    "parts": [
      {
        "text": "Your order for 2 units of the iPhone 16 has been successfully placed! Your order ID is 16. Thank you, Riad!"
      }
    ]
  }
]